---
/** A labelled rectangle: a tensor, a layer, a process, a memory. `label` may contain "\n" and $…$ TeX. */
import Label from './Label.astro'
import { lines, shape, size as sizes, type Size, type Tone } from './tones'

interface Props {
  x: number
  y: number
  w: number
  h: number
  label?: string
  /** Smaller second line under the label, e.g. a shape "(B, T, C)". */
  sub?: string
  tone?: Tone
  size?: Size
  mono?: boolean
  rx?: number
  /** Draw the label at the top-left instead of the centre (for containers). */
  title?: boolean
}
const { x, y, w, h, label, sub, tone = 'neutral', size = 'md', mono = false, rx = 6, title = false } = Astro.props
const colors = shape[tone]
const fontSize = sizes[size]
const subSize = Math.max(sizes.xs, fontSize - 2.5)
const centre = y + h / 2 - (sub ? subSize * 0.65 : 0)
const labelLines = lines(label, centre, fontSize)
const subY = (labelLines.at(-1)?.y ?? centre) + fontSize * 0.6 + subSize * 0.85
---
<g>
  <rect x={x} y={y} width={w} height={h} rx={rx} class:list={[colors.box, 'stroke-[1.5]']} />
  {title ? (
    label && <Label x={x + 10} y={y + fontSize + 6} label={label} fontSize={fontSize} bold tone={colors.text} />
  ) : (
    labelLines.map((line) => (
      <Label x={x + w / 2} y={line.y} label={line.value} anchor="middle" baseline="central" fontSize={fontSize} bold tone={colors.text} mono={mono} />
    ))
  )}
  {sub && !title && <Label x={x + w / 2} y={subY} label={sub} anchor="middle" baseline="central" fontSize={subSize} tone={colors.sub} mono />}
  <slot />
</g>
