---
/** A row of colour keys. */
import Label from './Label.astro'
import { labelWidth } from './tex'
import { shape, size as sizes, type Tone } from './tones'

interface Props {
  x: number
  y: number
  items: { label: string; tone: Tone }[]
  /** Space per item: horizontal for a row, vertical for a column. Rows default to the label width. */
  gap?: number
  direction?: 'row' | 'column'
}
const { x, y, items, gap, direction = 'row' } = Astro.props
let cursor = 0
const positions = items.map((item) => {
  const at = direction === 'column' ? { dx: 0, dy: cursor } : { dx: cursor, dy: 0 }
  cursor += direction === 'column' ? (gap ?? 22) : (gap ?? 18 + labelWidth(item.label) + 22)
  return at
})
---
<g>
  {items.map((item, index) => (
    <g>
      <rect x={x + positions[index].dx} y={y + positions[index].dy - 6} width={12} height={12} rx={3} class:list={[shape[item.tone].box, 'stroke-[1.25]']} />
      <Label x={x + positions[index].dx + 18} y={y + positions[index].dy} label={item.label} baseline="central" fontSize={sizes.sm} tone="fill-muted" />
    </g>
  ))}
</g>
