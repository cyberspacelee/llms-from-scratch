---
/**
 * A numbered function/data plot with axes, computed at build time.
 *
 *   <Plot label="三种激活函数" x={[-4, 4]} y={[-1.5, 4]}
 *         series={[{ fn: (t) => Math.max(0, t), label: 'ReLU' },
 *                  { fn: (t) => t / (1 + Math.exp(-t)), label: 'SiLU', tone: 'accent2' }]}>
 *     <Fragment slot="caption">……</Fragment>
 *   </Plot>
 */
import FigureShell from '../FigureShell.astro'
import { line as lineTones, size as sizes, type Tone } from './tones'

type Series = {
  label?: string
  tone?: Tone
  dashed?: boolean
  /** Sampled over the x domain. */
  fn?: (x: number) => number
  points?: [number, number][]
  samples?: number
}
type Marker = { at: [number, number]; label?: string; tone?: Tone }
interface Props {
  label: string
  x: [number, number]
  y: [number, number]
  series: Series[]
  markers?: Marker[]
  xLabel?: string
  yLabel?: string
  xTicks?: number[]
  yTicks?: number[]
  /** Log-scale the y axis (values must be positive). */
  logY?: boolean
  logX?: boolean
  width?: number
  height?: number
}
const { label, x: xDomain, y: yDomain, series, markers = [], xLabel, yLabel, logY = false, logX = false, width = 640, height = 300 } = Astro.props
const pad = { left: 56, right: 24, top: 18, bottom: xLabel ? 50 : 34 }
const tones: Tone[] = ['accent', 'accent2', 'info', 'muted', 'neutral']
const tx = (v: number) => (logX ? Math.log10(v) : v)
const ty = (v: number) => (logY ? Math.log10(v) : v)
const [x0, x1] = xDomain.map(tx), [y0, y1] = yDomain.map(ty)
const sx = (v: number) => pad.left + ((tx(v) - x0) / (x1 - x0)) * (width - pad.left - pad.right)
const sy = (v: number) => height - pad.bottom - ((ty(v) - y0) / (y1 - y0)) * (height - pad.top - pad.bottom)

function ticks(lo: number, hi: number, log: boolean): number[] {
  if (log) {
    const out = []
    for (let e = Math.ceil(Math.log10(lo)); e <= Math.floor(Math.log10(hi)); e += 1) out.push(10 ** e)
    return out
  }
  const span = hi - lo, raw = span / 6, mag = 10 ** Math.floor(Math.log10(raw))
  const step = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => span / s <= 7) ?? raw
  const out = []
  for (let v = Math.ceil(lo / step) * step; v <= hi + 1e-9; v += step) out.push(Number(v.toFixed(10)))
  return out
}
const xt = Astro.props.xTicks ?? ticks(xDomain[0], xDomain[1], logX)
const yt = Astro.props.yTicks ?? ticks(yDomain[0], yDomain[1], logY)
const fmt = (v: number) => (Math.abs(v) >= 1e4 || (Math.abs(v) < 1e-3 && v !== 0) ? v.toExponential(0) : String(Number(v.toPrecision(4))))

const paths = series.map((item, index) => {
  let pts = item.points
  if (!pts && item.fn) {
    const n = item.samples ?? 240
    pts = Array.from({ length: n + 1 }, (_, i) => {
      const t = x0 + ((x1 - x0) * i) / n
      const xv = logX ? 10 ** t : t
      return [xv, item.fn!(xv)] as [number, number]
    })
  }
  let d = '', pen = false
  for (const [px, py] of pts ?? []) {
    const ok = Number.isFinite(py) && (!logY || py > 0) && ty(py) >= y0 - (y1 - y0) * 0.05 && ty(py) <= y1 + (y1 - y0) * 0.05
    if (!ok) { pen = false; continue }
    d += `${pen ? 'L' : 'M'}${sx(px).toFixed(2)},${sy(py).toFixed(2)}`
    pen = true
  }
  return { d, tone: item.tone ?? tones[index % tones.length], dashed: item.dashed, label: item.label }
})
const legend = paths.filter((p) => p.label)
const clip = `plot-${crypto.randomUUID()}`
---
<FigureShell label={label}>
  <svg viewBox={`0 0 ${width} ${height + (legend.length ? 26 : 0)}`} role="img" aria-label={label} font-size={sizes.sm} class="mx-auto block h-auto w-full font-sans" style={`min-width:${Math.round(width * 0.7)}px`}>
    <defs><clipPath id={clip}><rect x={pad.left} y={pad.top} width={width - pad.left - pad.right} height={height - pad.top - pad.bottom} /></clipPath></defs>
    {yt.map((v) => <g>
      <line x1={pad.left} x2={width - pad.right} y1={sy(v)} y2={sy(v)} class="stroke-rule" stroke-width="1" />
      <text x={pad.left - 8} y={sy(v)} text-anchor="end" dominant-baseline="central" font-size={sizes.xs} class="fill-muted font-mono">{fmt(v)}</text>
    </g>)}
    {xt.map((v) => <g>
      <line x1={sx(v)} x2={sx(v)} y1={pad.top} y2={height - pad.bottom} class="stroke-rule" stroke-width="1" />
      <text x={sx(v)} y={height - pad.bottom + 16} text-anchor="middle" font-size={sizes.xs} class="fill-muted font-mono">{fmt(v)}</text>
    </g>)}
    {!logY && y0 < 0 && y1 > 0 && <line x1={pad.left} x2={width - pad.right} y1={sy(0)} y2={sy(0)} class="stroke-rule-strong" stroke-width="1.25" />}
    {!logX && x0 < 0 && x1 > 0 && <line x1={sx(0)} x2={sx(0)} y1={pad.top} y2={height - pad.bottom} class="stroke-rule-strong" stroke-width="1.25" />}
    <rect x={pad.left} y={pad.top} width={width - pad.left - pad.right} height={height - pad.top - pad.bottom} fill="none" class="stroke-rule-strong" stroke-width="1" />
    <g clip-path={`url(#${clip})`}>
      {paths.map((p) => <path d={p.d} fill="none" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" class:list={[lineTones[p.tone].stroke, p.dashed && '[stroke-dasharray:6_5]']} />)}
    </g>
    {markers.map((m) => <g>
      <circle cx={sx(m.at[0])} cy={sy(m.at[1])} r="4.5" class:list={[lineTones[m.tone ?? 'accent2'].fill, 'stroke-raised']} stroke-width="1.5" />
      {m.label && <text x={sx(m.at[0]) + 8} y={sy(m.at[1]) - 8} font-size={sizes.xs} paint-order="stroke" stroke-width="4" class="fill-ink stroke-raised">{m.label}</text>}
    </g>)}
    {xLabel && <text x={(pad.left + width - pad.right) / 2} y={height - 10} text-anchor="middle" font-size={sizes.sm} class="fill-muted">{xLabel}</text>}
    {yLabel && <text x={14} y={(pad.top + height - pad.bottom) / 2} text-anchor="middle" dominant-baseline="central" transform={`rotate(-90 14 ${(pad.top + height - pad.bottom) / 2})`} font-size={sizes.sm} class="fill-muted">{yLabel}</text>}
    {legend.map((p, index) => <g>
      <line x1={pad.left + index * 130} x2={pad.left + index * 130 + 22} y1={height + 12} y2={height + 12} stroke-width="2.5" class:list={[lineTones[p.tone].stroke, p.dashed && '[stroke-dasharray:6_5]']} />
      <text x={pad.left + index * 130 + 28} y={height + 12} dominant-baseline="central" font-size={sizes.sm} class="fill-ink">{p.label}</text>
    </g>)}
  </svg>
  {Astro.slots.has('caption') && <Fragment slot="caption"><slot name="caption" /></Fragment>}
</FigureShell>
