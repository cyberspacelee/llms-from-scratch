---
/** The frame and numbered caption shared by every figure and diagram. */
interface Props {
  /** Describes the drawing for the scroll region. */
  label: string
  /** Frame padding, for drawings that are not full-bleed SVGs. */
  padded?: boolean
}
const { label, padded = false } = Astro.props
---
<figure class="not-prose my-8 [counter-increment:figure]">
  <div
    class:list={['diagram-viewport rounded-lg border border-rule bg-raised text-ink', padded && 'p-4']}
    data-diagram-label={label}
  >
    <slot />
  </div>
  {Astro.slots.has('caption') && (
    <figcaption class="figure-number mt-3 text-sm text-muted text-pretty">
      <slot name="caption" />
    </figcaption>
  )}
</figure>

<script>
  import './diagram-viewport'
</script>
