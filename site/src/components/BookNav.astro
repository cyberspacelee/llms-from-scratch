---
/** The whole book as a tree: every part, its chapters, the current page marked. */
import { getBook, url, type Chapter } from '../lib/book'
import { parts } from '../lib/parts'

interface Props {
  current?: Chapter
}
const { current } = Astro.props
const book = await getBook()
---
<nav aria-label="全书目录" class="text-sm">
  <a href={url()} class="mb-4 block px-2 text-xs font-semibold text-muted no-underline hover:text-accent">全书目录</a>
  <ol class="m-0 list-none space-y-1 p-0">
    {parts.map((part) => {
      const chapters = book.filter((chapter) => chapter.part === part)
      const intro = chapters.find((chapter) => chapter.isIntro)
      const open = current?.part === part
      return (
        <li>
          <details open={open} class="group">
            <summary class="flex cursor-pointer items-baseline gap-2 rounded-lg px-2 py-1.5 text-muted hover:bg-sunken hover:text-ink [&::-webkit-details-marker]:hidden">
              <span aria-hidden="true" class="w-3 flex-none font-mono text-xs text-accent group-open:rotate-90 motion-safe:transition-transform">›</span>
              <span class:list={['min-w-0', open && 'font-semibold text-ink']}>{part.label}</span>
            </summary>
            <ol class="mt-1 mb-2 ml-3.5 list-none border-l border-rule p-0">
              {intro && (
                <li>
                  <a
                    href={url(intro.path)}
                    aria-current={intro === current ? 'page' : undefined}
                    class="-ml-px block border-l-2 border-transparent py-1 pr-2 pl-3 text-xs text-muted no-underline hover:text-ink aria-[current=page]:border-accent aria-[current=page]:font-semibold aria-[current=page]:text-ink"
                  >{part.numeral}导读</a>
                </li>
              )}
              {chapters.filter((chapter) => !chapter.isIntro).map((chapter) => (
                <li>
                  <a
                    href={url(chapter.path)}
                    aria-current={chapter === current ? 'page' : undefined}
                    class="-ml-px grid grid-cols-[1.75rem_minmax(0,1fr)] border-l-2 border-transparent py-1 pr-2 pl-3 text-muted no-underline hover:text-ink aria-[current=page]:border-accent aria-[current=page]:bg-accent-soft aria-[current=page]:font-semibold aria-[current=page]:text-ink"
                  >
                    <span class="font-mono text-xs leading-[inherit] text-accent">{chapter.number}</span>
                    <span>{chapter.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        </li>
      )
    })}
  </ol>
</nav>
