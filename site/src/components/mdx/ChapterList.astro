---
/** The chapters of a part, generated from the content collection. */
import { getPartChapters, url } from '../../lib/book'

interface Props {
  part: string
}
const { part } = Astro.props
const chapters = (await getPartChapters(part)).filter((chapter) => !chapter.isIntro)
---
<ol class="not-prose my-8 list-none border-t border-rule p-0">
  {chapters.map((chapter) => (
    <li>
      <a href={url(chapter.path)} class="group grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-3 border-b border-rule py-4 text-ink no-underline">
        <span class="pt-0.5 font-mono text-xs font-medium text-accent">第 {chapter.number} 章</span>
        <span class="font-semibold group-hover:text-accent">{chapter.title}</span>
        <span class="col-start-2 mt-1 text-sm text-muted">{chapter.description}</span>
      </a>
    </li>
  ))}
</ol>
