---
/** A definition or theorem the reader should stop and recognise. */
interface Props {
  term: string
  /** 定义, 定理, 命题 … */
  kind?: string
  source?: string
  sourceName?: string
}
const { term, kind = '定义', source, sourceName = '来源' } = Astro.props
---
<section class="not-prose my-8 rounded-r-lg border-l-[3px] border-accent bg-raised py-4 pr-4 pl-5 shadow-[0_0_0_1px_var(--color-rule)]" aria-label={`${kind}：${term}`}>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p class="m-0 text-base font-semibold text-ink"><span class="mr-2 text-accent">{kind}</span>{term}</p>
    {source && <a class="text-xs text-muted underline underline-offset-2 hover:text-accent" href={source}>{sourceName} ↗</a>}
  </div>
  <div class="mt-3 text-base leading-7 text-ink [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&_.katex-display]:my-3 [&_p]:my-2">
    <slot />
  </div>
</section>
