---
interface Props {
  term: string
  source: string
  sourceName?: string
}

const { term, source, sourceName = '定义来源' } = Astro.props
---
<section class="not-prose my-8 border-l-[3px] border-accent bg-accent-soft/40 py-4 pl-5 pr-4" aria-label={`定义：${term}`}>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="m-0 text-base font-semibold text-ink">定义 · {term}</h3>
    <a class="text-xs text-muted underline underline-offset-2 hover:text-accent" href={source}>{sourceName} ↗</a>
  </div>
  <div class="mt-3 text-base leading-7 text-ink [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&_.katex-display]:my-3 [&_p]:my-2">
    <slot />
  </div>
</section>
