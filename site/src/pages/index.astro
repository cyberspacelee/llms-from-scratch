---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getBook, repoUrl, url } from '../lib/book'
import { parts } from '../lib/parts'

const book = await getBook()
const chapters = book.filter((chapter) => !chapter.isIntro)
const first = chapters[0]
---
<BaseLayout title="LLMs From Scratch" description="一本从数学原理、PyTorch 实现到预训练、对齐、GPU 编程与推理系统的大语言模型中文技术书。">
  <main id="content" class="mx-auto max-w-page px-4 pb-24 sm:px-6">
    <section class="grid gap-10 border-b border-rule py-16 sm:py-24 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
      <div>
        <p class="mb-5 font-mono text-xs font-semibold tracking-widest text-accent">LLMS FROM SCRATCH</p>
        <h1 class="max-w-[18em] text-2xl font-semibold tracking-tight text-balance">从链式法则到推理引擎：<br class="hidden sm:block" />亲手构建大语言模型</h1>
        <p class="mt-6 mb-0 max-w-content text-lg text-muted text-pretty">
          一本层层递进的中文技术书。先用数学和 PyTorch 打好地基，再从零实现 Transformer，沿 2017—2026 年的架构演进走到 DeepSeek-V4；随后讲清预训练、分布式训练与对齐，最后深入 GPU 编程与 vLLM 式推理系统。每个公式都有推导，每个机制都有可运行的代码。
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          {first && <a href={url(first.path)} class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-paper no-underline hover:bg-accent-strong hover:text-paper">从第 1 章开始</a>}
          <a href="#toc" class="rounded-lg border border-rule-strong px-5 py-2.5 text-sm font-semibold text-ink no-underline hover:border-accent hover:text-accent-strong">浏览目录</a>
        </div>
      </div>
      <dl class="m-0 grid grid-cols-3 gap-px overflow-hidden rounded-lg border border-rule bg-rule lg:grid-cols-1">
        {[
          [String(parts.length), '个部分'],
          [String(chapters.length), '章'],
          ['PyTorch · CUDA · Triton', '代码'],
        ].map(([value, label]) => (
          <div class="flex flex-col-reverse bg-raised px-5 py-4">
            <dt class="text-xs text-muted">{label}</dt>
            <dd class="m-0 font-mono text-lg font-semibold text-accent">{value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="grid gap-8 border-b border-rule py-14 lg:grid-cols-3">
      {[
        ['原理', '数学推导先于结论：链式法则、反向传播、注意力、缩放定律、PPO/GRPO 的目标函数都从定义出发推出，并用小例子手算核对。'],
        ['实现', '每章的机制都落到 PyTorch 代码：自动微分引擎、BPE、GPT、AdamW 与 Muon、FSDP、LoRA、GRPO、FlashAttention、分页 KV Cache 与推理引擎。'],
        ['系统', '把模型放到真实硬件上：算 FLOPs 与显存，理解 GPU 的内存层次，写 CUDA 与 Triton kernel，再看 vLLM 怎样调度与批处理。'],
      ].map(([title, text]) => (
        <div>
          <h2 class="mb-2 text-lg font-semibold">{title}</h2>
          <p class="m-0 text-muted">{text}</p>
        </div>
      ))}
    </section>

    <section id="toc" aria-labelledby="toc-heading" class="scroll-mt-[calc(var(--spacing-header)+1rem)] py-14">
      <h2 id="toc-heading" class="mb-10 text-xl font-semibold">目录</h2>
      <ol class="m-0 grid list-none gap-x-12 gap-y-12 p-0 lg:grid-cols-2">
        {parts.map((part) => {
          const items = book.filter((chapter) => chapter.part === part && !chapter.isIntro)
          return (
            <li>
              <a href={url(part.id)} class="group block no-underline">
                <p class="mb-1 font-mono text-xs font-semibold text-accent">{part.numeral}</p>
                <h3 class="m-0 text-lg font-semibold text-ink group-hover:text-accent">{part.label}</h3>
              </a>
              <p class="mt-2 mb-4 text-sm text-muted">{part.summary}</p>
              <ol class="m-0 list-none border-t border-rule p-0">
                {items.map((chapter) => (
                  <li>
                    <a href={url(chapter.path)} class="group grid grid-cols-[2.5rem_minmax(0,1fr)] border-b border-rule py-2 text-sm text-ink no-underline">
                      <span class="font-mono text-xs leading-6 text-muted">{chapter.number}</span>
                      <span class="group-hover:text-accent">{chapter.title}{chapter.entry.data.draft && <span class="ml-2 text-xs text-muted">撰写中</span>}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </li>
          )
        })}
      </ol>
    </section>

    <section aria-labelledby="run-heading" class="grid gap-8 border-t border-rule py-14 lg:grid-cols-2">
      <div>
        <h2 id="run-heading" class="mb-2 text-xl font-semibold">代码与运行</h2>
        <p class="mt-0 text-muted">
          书中代码位于仓库的 <code class="font-mono text-code">src/llms_from_scratch/</code>，按部分组织并配有测试。默认环境只需 CPU；GPU 章节的 CUDA 与 Triton 示例需要 NVIDIA GPU，并在无硬件时自动跳过。
        </p>
        <p class="mb-0 text-sm"><a href={repoUrl}>在 GitHub 查看全部源码</a></p>
      </div>
      <pre class="m-0 overflow-x-auto rounded-lg border border-rule bg-code-bg px-5 py-4 font-mono text-code"><code>uv sync --locked --group dev
uv run pytest
uv run python -m llms_from_scratch.transformer.train --help</code></pre>
    </section>
  </main>
</BaseLayout>
