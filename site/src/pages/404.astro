---
import BaseLayout from '../layouts/BaseLayout.astro'
import { url } from '../lib/book'
import { parts } from '../lib/parts'
---
<BaseLayout title="页面不存在" description="这个地址没有对应的章节。">
  <main id="content" class="mx-auto max-w-content px-4 py-20 sm:px-6">
    <p class="mb-3 font-mono text-xs font-semibold text-accent">404</p>
    <h1 class="text-2xl font-semibold tracking-tight">这个地址没有对应的章节</h1>
    <p class="mt-4 text-lg text-muted">可以从下面任一部分的导读重新进入。</p>
    <ul class="mt-8 list-none space-y-2 p-0">
      {parts.map((part) => (
        <li><a href={url(part.id)} class="font-semibold">{part.numeral} · {part.label}</a></li>
      ))}
    </ul>
    <p class="mt-8 text-sm"><a href={url()}>回到首页</a></p>
  </main>
</BaseLayout>
