---
import BaseLayout from '../layouts/BaseLayout.astro'
import { url } from '../lib/lessons'
import { tracks } from '../lib/tracks'
---
<BaseLayout title="页面不存在" description="这个地址没有对应的讲义。">
  <main id="content" class="mx-auto max-w-content px-4 py-20 sm:px-6">
    <p class="mb-3 font-mono text-xs font-semibold text-accent">404</p>
    <h1 class="text-2xl font-semibold tracking-tight">这个地址没有对应的讲义</h1>
    <p class="mt-4 text-lg text-muted">讲义按三条路线组织，可以从路线导读重新进入。</p>
    <ul class="mt-8 list-none space-y-2 p-0">
      {tracks.map((track) => (
        <li><a href={url(track.id)} class="font-semibold">{track.label}</a><span class="text-sm text-muted"> · {track.summary}</span></li>
      ))}
    </ul>
    <p class="mt-8 text-sm"><a href={url()}>回到首页</a></p>
  </main>
</BaseLayout>
