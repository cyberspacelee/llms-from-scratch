---
import { render } from 'astro:content'
import ChapterLayout from '../layouts/ChapterLayout.astro'
import { getBook, type Chapter } from '../lib/book'
import { mdxComponents } from '../lib/mdx-components'

export async function getStaticPaths() {
  const book = await getBook()
  return book.map((chapter) => ({ params: { path: chapter.path }, props: { chapter } }))
}

const { chapter } = Astro.props as { chapter: Chapter }
const { Content, headings } = await render(chapter.entry)
---
<ChapterLayout chapter={chapter} headings={headings}>
  <Content components={mdxComponents} />
</ChapterLayout>
