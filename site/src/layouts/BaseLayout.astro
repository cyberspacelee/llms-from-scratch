---
import '../styles/global.css'
import { tracks } from '../lib/tracks'
import { repoUrl, url } from '../lib/lessons'

interface Props {
  title: string
  description: string
  /** Track highlighted in the header. */
  trackId?: string
  /** Show the reading-progress bar and the drawer toggle for the sidebar. */
  reading?: boolean
}

const { title, description, trackId, reading = false } = Astro.props
const pageTitle = title === 'LLMs From Scratch' ? title : `${title} · LLMs From Scratch`
---
<!doctype html>
<html lang="zh-CN" data-theme="light" data-theme-choice="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <link rel="icon" href={`${url()}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Resolve the theme before first paint so the page never flashes.
      (() => {
        let choice = 'system'
        try { choice = localStorage.getItem('theme') || 'system' } catch {}
        const dark = choice === 'dark' || (choice === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.dataset.theme = dark ? 'dark' : 'light'
        document.documentElement.dataset.themeChoice = choice
      })()
    </script>
  </head>
  <body>
    <a
      href="#content"
      class="fixed top-2 left-2 z-50 -translate-y-[200%] rounded-lg bg-ink px-3 py-2 text-paper focus:translate-y-0"
    >跳到正文</a>

    <header class="sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur-md backdrop-saturate-150">
      <div class="mx-auto flex h-header max-w-page items-center gap-3 px-4 sm:gap-6 sm:px-6">
        {reading && (
          <button
            type="button"
            data-nav-toggle
            aria-controls="sidebar"
            aria-expanded="false"
            aria-label="打开章节目录"
            class="-ml-2 grid size-10 place-items-center rounded-lg text-muted hover:bg-sunken hover:text-ink lg:hidden"
          >
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        )}
        <a href={url()} class="flex flex-none items-center gap-2 text-sm font-semibold text-ink no-underline">
          <svg viewBox="0 0 32 32" class="size-6" aria-hidden="true">
            <rect width="32" height="32" rx="7" class="fill-accent" />
            <path d="M9 22V10h3.2v9.4H18V22zM19.6 22V10h3.2v12z" class="fill-paper" />
          </svg>
          LLMs From Scratch
        </a>
        <nav aria-label="学习路线" class="hidden gap-1 sm:flex">
          {tracks.map((track) => (
            <a
              href={url(track.id)}
              aria-current={track.id === trackId ? 'page' : undefined}
              class="rounded-full px-3 py-1 text-sm whitespace-nowrap text-muted no-underline hover:bg-sunken hover:text-ink aria-[current=page]:bg-accent-soft aria-[current=page]:font-semibold aria-[current=page]:text-accent-strong"
            >{track.label}</a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-1">
          <a
            href={repoUrl}
            aria-label="GitHub 仓库"
            class="grid size-10 place-items-center rounded-lg text-muted hover:bg-sunken hover:text-ink"
          >
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.46-1.1-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.93.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
            </svg>
          </a>
          <button
            type="button"
            data-theme-toggle
            class="grid size-10 place-items-center rounded-lg text-muted hover:bg-sunken hover:text-ink"
            aria-label="配色：跟随系统"
          >
            <svg viewBox="0 0 24 24" class="hidden size-5 in-data-[theme-choice=system]:block" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" stroke-linecap="round" />
            </svg>
            <svg viewBox="0 0 24 24" class="hidden size-5 in-data-[theme-choice=light]:block" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg viewBox="0 0 24 24" class="hidden size-5 in-data-[theme-choice=dark]:block" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
            </svg>
          </button>
        </div>
      </div>
      {reading && (
        <div
          data-progress
          aria-hidden="true"
          class="absolute inset-x-0 -bottom-px h-0.5 origin-left scale-x-0 bg-accent"
        ></div>
      )}
    </header>

    <slot />

    <footer class="border-t border-rule text-xs text-muted">
      <div class="mx-auto flex max-w-page flex-wrap justify-between gap-3 px-4 py-6 sm:px-6">
        <p class="m-0">LLMs From Scratch · 用推导、图解与可运行代码理解大语言模型</p>
        <p class="m-0"><a href={repoUrl} class="text-muted">源码与验证脚本</a></p>
      </div>
    </footer>

    <script>
      import '../scripts/site'
    </script>
  </body>
</html>
