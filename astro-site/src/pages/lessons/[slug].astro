---
import { getCollection, render } from 'astro:content'
import LessonLayout from '../../layouts/LessonLayout.astro'
export async function getStaticPaths() {
  const entries = await getCollection('lessons')
  return entries.map(entry => ({ params: { slug: entry.id.replace(/\.mdx?$/, '') }, props: { entry } }))
}
const { entry } = Astro.props
const { Content, headings } = await render(entry)
---
<LessonLayout title={entry.data.title} description={entry.data.description} headings={headings}>
  <article id="lesson-content"><Content /></article>
</LessonLayout>
