---
import LessonLayout from '../layouts/LessonLayout.astro'
import { infraItems, principleItems } from '../data/series'
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---
<LessonLayout
  rail={false}
  progress={false}
  kicker="目录"
  title="阅读路线"
  description="用数学推导、SVG 图解与 PyTorch 验证理解大语言模型，再沿一次请求的账单进入 AI Infra。"
>
  <section class="route-index">
    <h2>模型原理</h2>
    {principleItems.map((item) => (
      <a href={`${base}${item.href}`}><strong>{item.sidebar}</strong><span>{item.question}</span></a>
    ))}
    <h2>AI Infra</h2>
    {infraItems.map((item) => (
      <a href={`${base}${item.href}`}><strong>{item.sidebar}</strong><span>{item.question}</span></a>
    ))}
  </section>
</LessonLayout>
