---
import '../styles/site.css'
import SeriesLinks from '../components/SeriesLinks.astro'
import { findSeries, series, topNav } from '../data/series'

type Heading = { depth: number; slug: string; text: string }
const {
  title,
  description,
  rail,
  kicker,
  slug,
  progress = true,
} = Astro.props
const headings = ((Astro.props.headings ?? []) as Heading[]).filter((heading) => heading.depth === 2)
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const current = findSeries(slug)
const index = current ? series.findIndex((item) => item.id === current.id) : -1
const prev = index > 0 ? series[index - 1] : undefined
const next = index >= 0 && index < series.length - 1 ? series[index + 1] : undefined
const onInfra = current?.group === 'infra'
const showRail = rail ?? Boolean(current)
const edition = kicker ?? current?.kicker ?? '讲义'
const href = (path: string) => `${base}${path}`
const topOn = (id: string) => {
  if (!current) return false
  if (id === 'ai-infra') return current.group === 'infra'
  if (id === 'mathematics') return current.id === 'mathematics' || current.group === 'math'
  return current.id === id
}
---
<!doctype html>
<html lang="zh-CN" data-progress={progress ? undefined : 'off'}>
  <head>
    <meta charset="UTF-8" />
    <base href={slug ? `${base}lessons/${slug}/` : base} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · LLMs From Scratch</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css" crossorigin="anonymous" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored === 'dark' || (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
          var root = document.documentElement;
          root.classList.toggle('dark', dark);
          root.dataset.theme = stored || 'system';
          root.style.colorScheme = dark ? 'dark' : 'light';
        } catch (error) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header">
      <div class="header-bar">
        <div class="bar-inner">
          <a class="brand" href={base}>LLMs From Scratch</a>
          <nav class="switch" aria-label="系列讲义">
            {topNav.map((item) => (
              <a href={href(item.href)} aria-current={topOn(item.id) ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>
          <p class="read-label" id="read-label"></p>
          <button class="theme-toggle" type="button">系统</button>
        </div>
        <div class="read-progress" aria-hidden="true"><div id="read-bar"></div></div>
      </div>
      <div class="hero-inner">
        <p class="edition">{edition}</p>
        <h1>{title}</h1>
        {description && <p class="hero-description">{description}</p>}
      </div>
    </header>
    <div class:list={['layout', { 'layout-single': !showRail }]}>
      {showRail && (
        <aside class="sidebar">
          <SeriesLinks base={base} currentId={current?.id} onInfra={onInfra} headings={headings} />
        </aside>
      )}
      <details class="mobile-toc">
        <summary>目录</summary>
        <div class="mobile-toc-list">
          <SeriesLinks base={base} currentId={current?.id} onInfra={onInfra} headings={headings} />
        </div>
      </details>
      <main id="content">
        <slot />
        {(prev || next) && (
          <nav class="series-footer" aria-label="前后篇">
            {prev && <a class="prev" href={href(prev.href)} rel="prev">上一篇 · {prev.nav}</a>}
            {next && <a class="next" href={href(next.href)} rel="next">下一篇 · {next.nav}</a>}
          </nav>
        )}
      </main>
    </div>
    <script src={`${base}assets/reader.js`} defer></script>
    <script is:inline>
      document.querySelectorAll('[data-chapter-outline]').forEach((outline) => {
        const heads = [...document.querySelectorAll('#lesson-content h2')].filter((heading) => heading.id)
        if (!heads.length) return
        const label = document.createElement('p')
        label.textContent = '本章各节'
        const links = document.createElement('div')
        for (const heading of heads) {
          const link = document.createElement('a')
          link.href = '#' + heading.id
          link.textContent = heading.textContent
          links.append(link)
        }
        outline.replaceChildren(label, links)
      })
      ;(async () => {
        const highlighted = document.querySelectorAll('pre[data-language="mermaid"]')
        for (const pre of highlighted) {
          const lines = [...pre.querySelectorAll('.line')].map((line) => line.textContent ?? '')
          const diagram = document.createElement('div')
          diagram.className = 'mermaid'
          diagram.textContent = lines.length > 0 ? lines.join('\n') : (pre.textContent ?? '')
          pre.replaceWith(diagram)
        }
        const blocks = [...document.querySelectorAll('.mermaid')].filter((node) => !node.querySelector('svg'))
        if (blocks.length === 0) return
        const mermaid = (await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')).default
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'loose',
          theme: 'base',
          fontFamily: 'PingFang SC, Noto Sans SC, Microsoft YaHei, sans-serif',
          themeVariables: {
            primaryColor: '#e7f2ef',
            primaryTextColor: '#1c2926',
            primaryBorderColor: '#087f70',
            secondaryColor: '#f4f7f5',
            tertiaryColor: '#fffefa',
            lineColor: '#68726d',
            textColor: '#1c2926',
            fontSize: '15px',
          },
          flowchart: { htmlLabels: true, useMaxWidth: true },
          sequence: { useMaxWidth: true },
        })
        for (const [index, block] of blocks.entries()) {
          const source = block.textContent ?? ''
          const id = `mmd-${index}-${Math.random().toString(36).slice(2, 8)}`
          try {
            const rendered = await mermaid.render(id, source)
            block.innerHTML = rendered.svg
          } catch (error) {
            console.error(error)
            block.classList.add('mermaid-failed')
          }
        }
      })()
    </script>
  </body>
</html>
